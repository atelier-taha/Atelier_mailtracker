# ==============================================================================
# Atelier's MailTracker — Production Environment Configuration
# atelierforge-tools // MAIL INTELLIGENCE & TELEMETRY
# ==============================================================================
# Copy this file to .env.local for local testing, or configure these variables
# directly in your Vercel Project Settings (Settings -> Environment Variables).
#
# NOTE: If KV/Redis environment variables are omitted, MailTracker runs with an
# in-memory fallback suitable for zero-dependency local unit testing.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. UPSTASH REDIS / VERCEL KV STORAGE (PERSISTENCE LAYER)
# ------------------------------------------------------------------------------
# Required for serverless state persistence of email open counts, click counts,
# first/last opened timestamps, and geo-location analytics (/api/status).
# Obtain these credentials from your Upstash console (https://console.upstash.com)
# or via the Vercel Storage tab (Vercel KV integration).
#
# Upstash REST API Endpoint (HTTPS only):
KV_REST_API_URL="https://your-upstash-redis-instance.upstash.io"
# Upstash REST Read/Write Authentication Token:
KV_REST_API_TOKEN="your_upstash_rest_api_token_here"

# Alternative variable names recognized by the storage engine:
# UPSTASH_REDIS_REST_URL="https://your-upstash-redis-instance.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="your_upstash_rest_api_token_here"

# ------------------------------------------------------------------------------
# 2. CRYPTOGRAPHIC LINK SIGNING SECRET (OPEN-REDIRECT DEFENSE)
# ------------------------------------------------------------------------------
# High-entropy secret key used to compute and verify HMAC-SHA256 signatures (&sig=)
# on all tracked hyperlinks in /api/click.js.
#
# Security Notice: When configured, /api/click will strictly reject redirect
# requests with invalid or tampered signatures, preventing open-redirect exploitation.
# Generate a secure 32+ character key: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TRACKING_SECRET="your_high_entropy_32_byte_hmac_tracking_secret_here"

# Alternative alias recognized by the security engine:
# APP_SECRET="your_high_entropy_32_byte_hmac_tracking_secret_here"

# ------------------------------------------------------------------------------
# 3. WEBHOOK NOTIFICATIONS & SSRF MITIGATION
# ------------------------------------------------------------------------------
# Default fallback webhook URL to receive open/click alerts (e.g., Discord or Telegram).
# If unconfigured or empty, remote webhooks are skipped safely without throwing errors.
WEBHOOK_URL="https://discord.com/api/webhooks/your_webhook_id/your_webhook_token"

# Comma-separated list of permitted target domains for webhooks.
# Protects serverless functions against Server-Side Request Forgery (SSRF),
# loopback interception (localhost, 127.0.0.1), and cloud metadata IP access (169.254.169.254).
ALLOWED_WEBHOOK_DOMAINS="discord.com,discordapp.com,api.telegram.org,hooks.slack.com"

# ------------------------------------------------------------------------------
# 4. PUBLIC DEPLOYMENT ENDPOINT
# ------------------------------------------------------------------------------
# The fully-qualified public URL where your Vercel serverless API is deployed.
# Used by the Chrome extension to target tracking pixels, link rewrites, and status queries.
API_BASE_URL="https://atelier-mailtracker.vercel.app"
NEXT_PUBLIC_API_URL="https://atelier-mailtracker.vercel.app"
