{
  "manifest_version": 3,
  "name": "Atelier's MailTracker — Mail Intelligence & Security Suite",
  "version": "2.0.0",
  "description": "Email header forensics, visual hop mapping, SPF/DKIM/DMARC verification, spoof detection, and invisible open/click tracking.",
  "permissions": [
    "storage",
    "activeTab",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://mail.google.com/*",
    "https://*.vercel.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Atelier's MailTracker — Mail Intelligence",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "lib/header-parser.js",
        "lib/auth-verifier.js",
        "lib/spoof-detector.js",
        "lib/forensic-exporter.js",
        "lib/notification-engine.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
